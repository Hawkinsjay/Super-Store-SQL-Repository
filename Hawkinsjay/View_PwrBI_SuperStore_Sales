CREATE VIEW V_PowerBI_SuperStore_Sales AS

WITH base_orders AS (
    SELECT
        Row_ID,
        Order_ID,
        Order_Date,
        Customer_ID,
        Product_ID,
        Sales,
        Quantity,
        Profit,
        strftime('%Y', Order_Date)     AS order_year,
        strftime('%Y-%m', Order_Date)  AS order_month
    FROM SuperStore_Orders
),

sales_metrics AS (
    SELECT
        Row_ID,
        ROUND(SUM(Sales) OVER (PARTITION BY Order_Date),2) AS daily_sales_total,
		ROUND(SUM(Sales) OVER (PARTITION BY order_month),2) AS monthly_sales_total,
		ROUND(AVG(Sales) OVER (PARTITION BY order_month),2) AS avg_monthly_sales,
		ROUND(SUM(Sales) OVER (PARTITION BY Customer_ID),2) AS customer_lifetime_spend,
		MAX(Order_Date) OVER (PARTITION BY Customer_ID) AS last_purchase_date
    FROM base_orders
)

SELECT
    orders.Row_ID,
    orders.Order_ID,
    orders.order_year AS Year,
    orders.order_month AS Month,
    orders.Order_Date,
    orders.Customer_ID,
    orders.Product_ID,

    products.Category,
    products.Sub_Category,
    products.Product_Name,

    ROUND(orders.Sales, 2)  AS Sales_Amount,
    orders.Quantity,
    ROUND(orders.Profit, 2) AS Profit_Amount,

    metrics.daily_sales_total,
    metrics.monthly_sales_total,
    metrics.avg_monthly_sales,
    metrics.customer_lifetime_spend,
    metrics.last_purchase_date,

    customers.Customer_Name,
    customers.Age,
    customers.Gender,
    customers.Country,
    customers.City,
    customers.State

FROM base_orders orders

INNER JOIN SuperStore_Customer_Details customers
    ON orders.Customer_ID = customers.Customer_ID

INNER JOIN SuperStore_Products products
    ON orders.Product_ID = products.Product_ID

INNER JOIN sales_metrics metrics
    ON orders.Row_ID = metrics.Row_ID;
